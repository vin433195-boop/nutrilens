# Sao chép file này thành .env rồi sửa giá trị phù hợp

# Kết nối MySQL/MariaDB. Nên dùng tài khoản riêng chỉ có quyền trên database nutrilens:
#   CREATE USER 'nutrilens'@'127.0.0.1' IDENTIFIED BY 'mat-khau-manh';
#   GRANT ALL PRIVILEGES ON nutrilens.* TO 'nutrilens'@'127.0.0.1';
DATABASE_URL=mysql+pymysql://nutrilens:mat-khau-manh@127.0.0.1:3306/nutrilens?charset=utf8mb4

# Khóa bí mật cho phiên đăng nhập. Tạo bằng: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Bật khi chạy qua HTTPS (đồng thời bật header HSTS)
COOKIE_SECURE=0

# Giới hạn số request theo IP. Chạy nhiều tiến trình thì dùng redis://localhost:6379
RATELIMIT_ENABLED=1
RATELIMIT_STORAGE_URI=memory://

# Gửi email quên mật khẩu (để trống MAIL_SERVER thì link được in ra cửa sổ dòng lệnh)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=NutriLens <no-reply@nutrilens.local>

# Nạp model AI ở nền ngay khi có request đầu tiên
PRELOAD_MODEL=1
