# Sao chép file này thành .env rồi sửa giá trị phù hợp

# Kết nối MySQL/MariaDB. Nên dùng tài khoản riêng chỉ có quyền trên database nutrilens:
#   CREATE USER 'nutrilens'@'127.0.0.1' IDENTIFIED BY 'mat-khau-manh';
#   GRANT ALL PRIVILEGES ON nutrilens.* TO 'nutrilens'@'127.0.0.1';
DATABASE_URL=mysql+pymysql://nutrilens:mat-khau-manh@127.0.0.1:3306/nutrilens?charset=utf8mb4

# Khóa bí mật cho phiên đăng nhập. Tạo bằng: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Bật khi chạy qua HTTPS (đồng thời bật header HSTS)
COOKIE_SECURE=0

# Giới hạn số request theo IP. Chạy nhiều tiến trình thì dùng redis://localhost:6379
RATELIMIT_ENABLED=1
RATELIMIT_STORAGE_URI=memory://

# Gửi email qua Brevo (API HTTPS, miễn phí). Dùng cách này trên Render vì bản miễn phí chặn cổng SMTP.
#   1. Đăng ký brevo.com, vào Senders & IP > Senders, thêm và xác minh email người gửi
#   2. Vào SMTP & API > API Keys, tạo key rồi điền vào đây
#   3. MAIL_SENDER phải đúng email người gửi đã xác minh, ví dụ: NutriLens <ban@gmail.com>
# Khi đã cấu hình gửi mail, người dùng phải bấm link xác thực trong email mới đăng nhập được.
BREVO_API_KEY=
# auto: bắt buộc xác thực khi đã cấu hình gửi mail | 1: luôn bắt buộc | 0: không bắt buộc
REQUIRE_EMAIL_VERIFICATION=auto
# Kiểm tra tên miền email có máy chủ nhận thư khi đăng ký
EMAIL_CHECK_DNS=1

# Hoặc gửi qua SMTP. Để trống cả BREVO_API_KEY và MAIL_SERVER thì link được in ra cửa sổ dòng lệnh.
# Ví dụ Gmail: bật xác minh 2 bước, tạo "Mật khẩu ứng dụng" tại https://myaccount.google.com/apppasswords
#   MAIL_SERVER=smtp.gmail.com  MAIL_PORT=587  MAIL_USE_TLS=1
#   MAIL_USERNAME=ban@gmail.com MAIL_PASSWORD=<mật khẩu ứng dụng 16 ký tự>
#   MAIL_SENDER=NutriLens <ban@gmail.com>
# Kiểm tra: flask --app app send-test-email ban@gmail.com
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER=NutriLens <no-reply@nutrilens.local>

# Nạp model AI ở nền ngay khi có request đầu tiên
PRELOAD_MODEL=1

# ── Vận hành ──
ENVIRONMENT=development
# Bật khi chạy sau Nginx/Caddy để lấy đúng IP người dùng và https
TRUST_PROXY=0
LOG_DIR=logs
# Theo dõi lỗi (tùy chọn): pip install "sentry-sdk[flask]" rồi điền DSN
SENTRY_DSN=
BACKUP_DIR=backups
BACKUP_KEEP=14
# Đường dẫn mysqldump nếu không nằm trong PATH (XAMPP được tự nhận ra)
MYSQLDUMP_PATH=

# ── Chỉ dùng cho docker compose ──
DB_PASSWORD=
DB_ROOT_PASSWORD=
DOMAIN=
